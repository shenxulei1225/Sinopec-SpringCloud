<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.cheers.x</groupId>
        <artifactId>cheers-business-middle-platform</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>
    <artifactId>cheers-gis-server</artifactId>
    <packaging>jar</packaging>
    <name>${project.artifactId}</name>
    <description>GIS 标准服务 Server（坐标/CRS/图层）</description>
    <dependencies>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-env</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-gis-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-system-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-biz-tenant</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-rpc</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-monitor</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.geotools</groupId>
            <artifactId>gt-referencing</artifactId>
            <version>32.2</version>
        </dependency>
        <dependency>
            <groupId>org.geotools</groupId>
            <artifactId>gt-main</artifactId>
            <version>32.2</version>
        </dependency>
        <dependency>
            <groupId>org.geotools</groupId>
            <artifactId>gt-metadata</artifactId>
            <version>32.2</version>
        </dependency>
        <dependency>
            <groupId>org.geotools</groupId>
            <artifactId>gt-epsg-hsql</artifactId>
            <version>32.2</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <repositories>
        <repository>
            <id>osgeo</id>
            <name>OSGeo Release Repository</name>
            <url>https://repo.osgeo.org/repository/release/</url>
        </repository>
    </repositories>
</project>
