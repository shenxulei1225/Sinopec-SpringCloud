<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.cheers.x</groupId>
        <artifactId>cheers-business-middle-platform</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>cheers-scene-3d-server</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>三维场景平台 Server（scene/actor/asset/runtime）；坐标域见 cheers-gis-server</description>

    <dependencies>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-env</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-scene-3d-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-gis-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-system-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-infra-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-biz-tenant</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>11.20.0</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>11.20.0</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-rpc</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-job</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-mq</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
