{
  "description": "SOP merge 契约向量（动作树 + 按节点参数）；前后端共用。对应 ecs-react features/sop/mergeSopEffectiveConfig.test.ts",
  "vectors": [
    {
      "id": "template-defaults-empty-overrides",
      "template": {
        "actionTree": [
          { "nodeKey": "n1", "actionId": "act-arrive", "order": 1, "paramSlots": ["location_ref"] },
          { "nodeKey": "n2", "actionId": "act-aim", "order": 2, "paramSlots": ["yaw", "pitch"] }
        ],
        "paramsByNode": {
          "n1": { "location_ref": "point-default" },
          "n2": { "yaw": 0, "pitch": 0 }
        }
      },
      "treeOverride": null,
      "paramOverride": null,
      "expect": {
        "ok": true,
        "nodesLength": 2,
        "paramsByNode": {
          "n1": { "location_ref": "point-default" },
          "n2": { "yaw": 0, "pitch": 0 }
        }
      }
    },
    {
      "id": "param-override-per-node",
      "template": {
        "actionTree": [
          { "nodeKey": "n1", "actionId": "act-arrive", "order": 1, "paramSlots": ["location_ref"] },
          { "nodeKey": "n2", "actionId": "act-aim", "order": 2, "paramSlots": ["yaw", "pitch"] }
        ],
        "paramsByNode": {
          "n1": { "location_ref": "point-default" },
          "n2": { "yaw": 0, "pitch": 0 }
        }
      },
      "treeOverride": null,
      "paramOverride": {
        "n1": { "location_ref": "point-pg001" },
        "n2": { "yaw": 45, "pitch": -30 }
      },
      "expect": {
        "ok": true,
        "nodesLength": 2,
        "paramsByNode": {
          "n1": { "location_ref": "point-pg001" },
          "n2": { "yaw": 45, "pitch": -30 }
        }
      }
    },
    {
      "id": "replace-tree-with-hover",
      "template": {
        "actionTree": [
          { "nodeKey": "n1", "actionId": "act-arrive", "order": 1, "paramSlots": ["location_ref"] },
          { "nodeKey": "n2", "actionId": "act-aim", "order": 2, "paramSlots": ["yaw", "pitch"] }
        ],
        "paramsByNode": {
          "n1": { "location_ref": "point-default" },
          "n2": { "yaw": 0, "pitch": 0 }
        }
      },
      "treeOverride": {
        "replaceTree": [
          { "nodeKey": "n1", "actionId": "act-arrive", "order": 1, "paramSlots": ["location_ref"] },
          { "nodeKey": "n3", "actionId": "act-hover", "order": 2, "paramSlots": [] },
          { "nodeKey": "n2", "actionId": "act-aim", "order": 3, "paramSlots": ["yaw", "pitch"] }
        ]
      },
      "paramOverride": {
        "n1": { "location_ref": "point-pg002" },
        "n2": { "yaw": 10, "pitch": 20 }
      },
      "expect": {
        "ok": true,
        "nodesLength": 3,
        "secondActionId": "act-hover",
        "paramsByNode": {
          "n1": { "location_ref": "point-pg002" },
          "n2": { "yaw": 10, "pitch": 20 },
          "n3": {}
        }
      }
    },
    {
      "id": "gap-missing-location-ref-on-node",
      "template": {
        "actionTree": [
          { "nodeKey": "n1", "actionId": "act-arrive", "order": 1, "paramSlots": ["location_ref"] },
          { "nodeKey": "n2", "actionId": "act-aim", "order": 2, "paramSlots": ["yaw", "pitch"] }
        ],
        "paramsByNode": {
          "n2": { "yaw": 0, "pitch": 0 }
        }
      },
      "treeOverride": null,
      "paramOverride": {},
      "expect": {
        "ok": false,
        "gapCodes": ["MISSING_PARAM:n1:location_ref"]
      }
    }
  ]
}
