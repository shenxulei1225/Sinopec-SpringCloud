<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>cn.cheers.x</groupId>
        <artifactId>cheers-facility-management</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>cheers-facility-management-server</artifactId>
    <packaging>jar</packaging>

    <name>${project.artifactId}</name>
    <description>设施管理域 Server 模块</description>

    <dependencies>
        <!-- Spring Cloud 基础 -->
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-env</artifactId>
        </dependency>

        <!-- API 模块 -->
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-facility-management-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-system-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-dynamicbusiness-api</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-infra-api</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- Web 相关 -->
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-security</artifactId>
        </dependency>

        <!-- DB 相关 -->
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-mybatis</artifactId>
        </dependency>
        <!-- 多租户相关 -->
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-biz-tenant</artifactId>
        </dependency>
        <!-- Flyway 数据库迁移 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>11.20.0</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>11.20.0</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-redis</artifactId>
        </dependency>

        <!-- RPC 远程调用相关（包含 Nacos Discovery/Config） -->
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-rpc</artifactId>
        </dependency>

        <!-- Job 定时任务相关 -->
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-job</artifactId>
        </dependency>

        <!-- 消息队列相关 -->
        <dependency>
            <groupId>cn.cheers.x</groupId>
            <artifactId>cheers-spring-boot-starter-mq</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
